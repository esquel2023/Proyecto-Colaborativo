<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<BorderPane
        maxWidth="Infinity"
        maxHeight="Infinity"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.proyecto_colaborativo.Controlador.ControladorVenta"
        stylesheets="@style.css"
        styleClass="root-ventas">

    <center>

        <VBox spacing="10"
              maxWidth="Infinity"
              maxHeight="Infinity">

            <padding>
                <Insets top="10"
                        right="10"
                        bottom="10"
                        left="10"/>
            </padding>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <HBox alignment="CENTER_LEFT"
                  spacing="10"
                  maxWidth="Infinity"
                  styleClass="header-simple">

                <Label text="🛒"
                       styleClass="icono-header"/>

                <VBox spacing="2"
                      HBox.hgrow="ALWAYS">

                    <Label text="Ventas"
                           styleClass="titulo-oscuro"/>

                    <Label text="Realizar nueva venta"
                           styleClass="subtitulo-oscuro"/>

                </VBox>

                <VBox alignment="CENTER_RIGHT"
                      spacing="1">

                    <Label fx:id="labelFecha"
                           styleClass="fecha-texto"/>

                    <Label fx:id="labelHora"
                           styleClass="hora-texto"/>

                </VBox>

            </HBox>


            <!-- ================================================= -->
            <!-- CONTENIDO -->
            <!-- ================================================= -->

            <HBox spacing="8"
                  maxWidth="Infinity"
                  maxHeight="Infinity"
                  VBox.vgrow="ALWAYS">


                <!-- ================================================= -->
                <!-- LADO IZQUIERDO -->
                <!-- ================================================= -->

                <VBox spacing="8"
                      minWidth="0"
                      maxWidth="Infinity"
                      maxHeight="Infinity"
                      HBox.hgrow="ALWAYS"
                      styleClass="card-venta">


                    <!-- ============================================= -->
                    <!-- CLIENTE -->
                    <!-- ============================================= -->

                    <VBox spacing="6"
                          maxWidth="Infinity"
                          styleClass="barra-acciones">

                        <Label text="👤 Cliente"
                               styleClass="label-seccion"/>

                        <HBox alignment="CENTER_LEFT"
                              spacing="8"
                              maxWidth="Infinity">

                            <TextField
                                    promptText="Sin cliente seleccionado"
                                    minWidth="0"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS"
                                    styleClass="input"/>

                            <Button fx:id="agregarCliente"
                                    text="+ Agregar"
                                    styleClass="btn-cliente"/>

                            <Button fx:id="eliminarCliente"
                                    text="🗑 Eliminar"
                                    styleClass="btn-eliminar-cliente"/>

                        </HBox>

                    </VBox>


                    <!-- ============================================= -->
                    <!-- PRODUCTO -->
                    <!-- ============================================= -->

                    <VBox spacing="8"
                          minHeight="0"
                          maxWidth="Infinity"
                          maxHeight="Infinity"
                          VBox.vgrow="ALWAYS"
                          styleClass="barra-acciones">

                        <Label text="📦 Producto"
                               styleClass="label-seccion"/>


                        <!-- ========================================= -->
                        <!-- PRODUCTO EN UNA SOLA FILA -->
                        <!-- ========================================= -->

                        <HBox spacing="8"
                              alignment="BOTTOM_LEFT"
                              maxWidth="Infinity">


                            <!-- CÓDIGO -->

                            <VBox spacing="4"
                                  minWidth="100"
                                  prefWidth="105"
                                  maxWidth="105">

                                <Label text="Código"
                                       styleClass="label-resumen"/>

                                <TextField fx:id="codigo"
                                           promptText="Ej: 00123"
                                           minWidth="100"
                                           prefWidth="105"
                                           maxWidth="105"
                                           styleClass="input"/>

                            </VBox>


                            <!-- CÓDIGO DE BARRAS -->

                            <VBox spacing="4"
                                  minWidth="170"
                                  prefWidth="180"
                                  maxWidth="180">

                                <Label text="Código de barras"
                                       styleClass="label-resumen"/>

                                <TextField fx:id="codigoBarras"
                                           promptText="Ej: 7791234567890"
                                           minWidth="170"
                                           prefWidth="180"
                                           maxWidth="180"
                                           styleClass="input"/>

                            </VBox>


                            <!-- ESPACIO FLEXIBLE -->

                            <Region minWidth="0"
                                    HBox.hgrow="ALWAYS"/>


                            <!-- AGREGAR -->

                            <VBox spacing="4">

                                <Label text=" "
                                       styleClass="label-resumen"/>

                                <Button fx:id="botonAgregar"
                                        text="＋ Agregar"
                                        onAction="#clickAgregarVentaProducto"
                                        styleClass="btn-agregar"/>

                            </VBox>


                            <!-- QUITAR -->

                            <VBox spacing="4">

                                <Label text=" "
                                       styleClass="label-resumen"/>

                                <Button fx:id="botonEliminar"
                                        text="🗑 Quitar"
                                        styleClass="btn-toolbar"/>

                            </VBox>

                        </HBox>


                        <!-- ========================================= -->
                        <!-- TABLA -->
                        <!-- ========================================= -->

                        <TableView fx:id="TablaProductos"
                                   minHeight="170"
                                   minWidth="0"
                                   maxWidth="Infinity"
                                   maxHeight="Infinity"
                                   VBox.vgrow="ALWAYS"
                                   styleClass="tabla">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <columns>

                                <TableColumn fx:id="colCodigoDeBarra"
                                             text="Código"
                                             prefWidth="75"/>

                                <TableColumn fx:id="colNombre"
                                             text="Producto"
                                             prefWidth="170"/>

                                <TableColumn fx:id="colCantidad"
                                             text="Cantidad"
                                             prefWidth="65"/>

                                <TableColumn fx:id="colPrecio"
                                             text="Precio"
                                             prefWidth="75"/>

                                <TableColumn fx:id="colSubtotal"
                                             text="Subtotal"
                                             prefWidth="75"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>


                <!-- ================================================= -->
                <!-- RESUMEN -->
                <!-- ================================================= -->

                <VBox spacing="8"
                      minWidth="150"
                      prefWidth="165"
                      maxWidth="175"
                      maxHeight="Infinity"
                      styleClass="resumen-card">


                    <!-- TITULO -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="5">

                        <Label text="🧾"
                               styleClass="icono-resumen"/>

                        <Label text="Resumen"
                               styleClass="resumen-titulo"/>

                    </HBox>


                    <!-- TOTAL -->

                    <VBox spacing="3">

                        <Label text="Total a pagar"
                               styleClass="label-resumen"/>

                        <Label fx:id="labelVentasTotal"
                               text="0.00"
                               styleClass="total-grande"/>

                    </VBox>


                    <Separator/>


                    <!-- MÉTODO DE PAGO -->

                    <VBox spacing="3">

                        <Label text="Método de pago"
                               styleClass="label-resumen"/>

                        <ComboBox promptText="Efectivo"
                                  minWidth="0"
                                  maxWidth="Infinity"
                                  styleClass="combo">

                            <items>

                                <FXCollections fx:factory="observableArrayList">

                                    <String fx:value="Efectivo"/>

                                    <String fx:value="Tarjeta débito"/>

                                    <String fx:value="Tarjeta crédito"/>

                                </FXCollections>

                            </items>

                        </ComboBox>

                    </VBox>


                    <!-- DINERO RECIBIDO -->

                    <VBox spacing="3">

                        <Label text="Dinero recibido"
                               styleClass="label-resumen"/>

                        <TextField promptText="0.00"
                                   minWidth="0"
                                   maxWidth="Infinity"
                                   styleClass="input"/>

                    </VBox>


                    <!-- VUELTO -->

                    <VBox spacing="3">

                        <Label text="Vuelto"
                               styleClass="label-resumen"/>

                        <Label text="0.00"
                               styleClass="vuelto"/>

                    </VBox>


                    <Region VBox.vgrow="ALWAYS"/>


                    <!-- FINALIZAR -->

                    <Button text="✓ Finalizar"
                            maxWidth="Infinity"
                            styleClass="btn-finalizar"/>


                    <!-- CANCELAR -->

                    <Button text="✖ Cancelar"
                            maxWidth="Infinity"
                            styleClass="btn-cancelar"/>

                </VBox>

            </HBox>

        </VBox>

    </center>


    <!-- ================================================= -->
    <!-- BOTÓN OCULTO -->
    <!-- ================================================= -->

    <bottom>

        <Button fx:id="buttonAgregarVentaProducto"
                visible="false"
                managed="false"/>

    </bottom>

</BorderPane>