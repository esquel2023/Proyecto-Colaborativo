<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<AnchorPane prefHeight="520.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyecto_colaborativo.Controlador.ControladorVenta"
            stylesheets="@style.css">

    <children>
        <VBox spacing="14"
              AnchorPane.topAnchor="16"
              AnchorPane.rightAnchor="16"
              AnchorPane.bottomAnchor="16"
              AnchorPane.leftAnchor="16"
              styleClass="root-ventas">

            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="header-simple">
                <Label text="🛒" styleClass="icono-header"/>

                <VBox spacing="2">
                    <Label text="Ventas" styleClass="titulo-oscuro"/>
                    <Label text="Realizar nueva venta" styleClass="subtitulo-oscuro"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="labelFecha" styleClass="fecha-texto"/>
                    <Label fx:id="labelHora" styleClass="hora-texto"/>
                </VBox>
            </HBox>

            <HBox spacing="14" VBox.vgrow="ALWAYS">

                <VBox spacing="12" styleClass="card-venta" HBox.hgrow="ALWAYS">

                    <!-- CLIENTE -->
                    <VBox spacing="8" styleClass="barra-acciones">
                        <Label text="👤 Cliente" styleClass="label-seccion"/>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <TextField promptText="Sin cliente seleccionado"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="input"/>

                            <Button fx:id="agregarCliente"
                                    text="+ Agregar"
                                    minWidth="105"
                                    styleClass="btn-cliente"/>

                            <Button fx:id="buscarCliente"
                                    text="🔍 Buscar"
                                    minWidth="105"
                                    styleClass="btn-toolbar"/>

                            <Button fx:id="eliminarCliente"
                                    text="🗑 Eliminar"
                                    minWidth="105"
                                    styleClass="btn-eliminar-cliente"/>
                        </HBox>
                    </VBox>

                    <!-- PRODUCTO -->
                    <VBox spacing="8" styleClass="barra-acciones" VBox.vgrow="ALWAYS">
                        <Label text="📦 Producto" styleClass="label-seccion"/>

                        <GridPane hgap="10" vgap="4">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="23"/>
                                <ColumnConstraints percentWidth="31"/>
                                <ColumnConstraints percentWidth="22"/>
                                <ColumnConstraints percentWidth="24"/>
                            </columnConstraints>

                            <Label text="Código" styleClass="label-resumen"
                                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>

                            <Label text="Código de barras" styleClass="label-resumen"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="Precio final" styleClass="label-resumen"
                                   GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                            <Region GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                            <TextField fx:id="codigo"
                                       promptText="Ej: 00123"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="1"
                                       styleClass="input"/>

                            <TextField fx:id="codigoBarras"
                                       promptText="Ej: 7791234567890"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1"
                                       styleClass="input"/>

                            <TextField fx:id="precioFinal"
                                       promptText="Ej: 0.00"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="1"
                                       styleClass="input"/>

                            <Button fx:id="botonAgregar"
                                    text="＋ Agregar producto"
                                    onAction="#clickAgregarVentaProducto"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"
                                    styleClass="btn-agregar"/>
                        </GridPane>

                        <TableView fx:id="TablaProductos"
                                   styleClass="tabla"
                                   VBox.vgrow="ALWAYS">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <columns>
                                <TableColumn fx:id="colCodigoDeBarra" text="Código" prefWidth="90"/>
                                <TableColumn fx:id="colNombre" text="Producto" prefWidth="260"/>
                                <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80"/>
                                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="120"/>
                                <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="80"/>
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Button fx:id="botonEliminar"
                                    text="🗑 Quitar producto"
                                    styleClass="btn-toolbar"/>

                            <Button fx:id="botonModificar"
                                    text="✏ Modificar"
                                    styleClass="btn-toolbar"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="✖ Cancelar venta"
                                    styleClass="btn-cancelar"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- RESUMEN -->
                <VBox spacing="16" styleClass="resumen-card" prefWidth="320">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🧾" styleClass="icono-resumen"/>
                        <Label text="Resumen de venta" styleClass="resumen-titulo"/>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="Total a pagar" styleClass="label-resumen"/>
                        <Label fx:id="labelVentasTotal" text="0.00" styleClass="total-grande"/>
                    </VBox>

                    <Separator/>

                    <VBox spacing="6">
                        <Label text="Método de pago" styleClass="label-resumen"/>
                        <ComboBox promptText="Efectivo" maxWidth="Infinity" styleClass="combo">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Efectivo"/>
                                    <String fx:value="Tarjeta débito"/>
                                    <String fx:value="Tarjeta crédito"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Dinero recibido" styleClass="label-resumen"/>
                        <TextField promptText="0.00" styleClass="input"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Vuelto" styleClass="label-resumen"/>
                        <Label text="0.00" styleClass="vuelto"/>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button text="✓  Finalizar venta"
                            maxWidth="Infinity"
                            styleClass="btn-finalizar"/>
                </VBox>

            </HBox>
        </VBox>

        <Button fx:id="buttonAgregarVentaProducto" visible="false" managed="false"/>

    </children>
</AnchorPane>