<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@stylo.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyecto_colaborativo.Controlador.controladorStock">

   <!-- Barra superior -->

   <top>

      <MenuBar BorderPane.alignment="CENTER">

         <menus>

            <Menu text="Venta" />

            <Menu text="Producto" />

            <Menu text="Historial" />

            <Menu text="Registro" />

            <Menu text="Cliente" />

            <Menu text="Proveedor" />

         </menus>

      </MenuBar>

   </top>

   <!-- Contenido -->

   <center>

      <VBox spacing="20" styleClass="main-card">

         <padding>
            <Insets bottom="25" left="25" right="25" top="25" />
         </padding>

         <!-- Encabezado -->

         <HBox alignment="CENTER_LEFT">

            <VBox spacing="5">

               <Label styleClass="page-title" text="Gestión de Stock" />

               <Label styleClass="page-subtitle" text="Administra productos, cantidades y movimientos" />

            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <DatePicker fx:id="date" />

         </HBox>

         <!-- Botones -->

         <HBox alignment="CENTER_LEFT" spacing="15">

            <Button fx:id="botonAgregar" onAction="#clickAgregar" prefHeight="40" prefWidth="150" styleClass="action-button btn-primary" text="➕ Agregar" />

            <Button fx:id="botonModificar" onAction="#clickModificar" prefHeight="40" prefWidth="150" styleClass="action-button btn-warning" text="✏ Modificar" />

            <Button fx:id="botonEliminar" onAction="#clickEliminar" prefHeight="40" prefWidth="150" styleClass="action-button btn-danger" text="🗑 Eliminar" />

         </HBox>

         <!-- Campos -->

         <GridPane hgap="15" vgap="15">

            <columnConstraints>

               <ColumnConstraints percentWidth="33" />

               <ColumnConstraints percentWidth="33" />

               <ColumnConstraints percentWidth="34" />

            </columnConstraints>

            <TextField fx:id="codigo" promptText="Código" styleClass="form-field" GridPane.columnIndex="0" />

            <TextField fx:id="codigoBarras" promptText="Código de barras" styleClass="form-field" GridPane.columnIndex="1" />

            <HBox spacing="10" GridPane.columnSpan="3" GridPane.rowIndex="1">

               <TextField fx:id="buscadorProductos" promptText="Buscar producto..." styleClass="form-field" HBox.hgrow="ALWAYS" />

               <Button fx:id="lupa" onAction="#ClickLupa" styleClass="btn-primary btn-icon" text="🔍" />

            </HBox>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>

         </GridPane>

         <!-- Tabla -->

         <TableView fx:id="tablaProductos" prefHeight="397.0" prefWidth="1000.0" VBox.vgrow="ALWAYS">

            <columns>

               <TableColumn fx:id="Codigo" prefWidth="90" text="Código" />

               <TableColumn fx:id="Producto" prefWidth="220" text="Producto" />

               <TableColumn fx:id="Cantidad" prefWidth="120" text="Cantidad" />

               <TableColumn fx:id="Descripcion" prefWidth="350" text="Descripción" />

               <TableColumn fx:id="Fecha" prefWidth="220" text="Fecha" />

            </columns>

         </TableView>

      </VBox>

   </center>

</BorderPane>
