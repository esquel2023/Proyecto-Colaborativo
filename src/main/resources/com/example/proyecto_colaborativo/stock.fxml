<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyecto_colaborativo.Controlador.controladorStock"
            stylesheets="@style.css"
            styleClass="root-stock">

   <center>

      <VBox spacing="16"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="content">

         <padding>
            <Insets top="16"
                    right="16"
                    bottom="16"
                    left="16"/>
         </padding>


         <!-- =====================================================
              HEADER
              ===================================================== -->

         <HBox alignment="CENTER_LEFT"
               maxWidth="Infinity"
               styleClass="header-simple">

            <VBox spacing="3"
                  HBox.hgrow="ALWAYS">

               <Label text="📚 Stock"
                      styleClass="titulo-oscuro"/>

               <Label text="Gestión y control de productos"
                      styleClass="subtitulo-oscuro"/>

            </VBox>

            <VBox alignment="CENTER_RIGHT"
                  spacing="2">

               <Label fx:id="fechaLabel"
                      text="Fecha"
                      styleClass="fecha-texto"/>

               <Label fx:id="horaLabel"
                      text="Hora"
                      styleClass="hora-texto"/>

            </VBox>

         </HBox>


         <!-- =====================================================
              GESTIÓN DE STOCK
              ===================================================== -->

         <VBox spacing="14"
               maxWidth="Infinity"
               styleClass="card-venta">

            <HBox alignment="CENTER_LEFT"
                  maxWidth="Infinity">

               <Label text="Gestión de stock"
                      styleClass="label-seccion"/>

               <Region HBox.hgrow="ALWAYS"/>

               <Label text="Fecha"
                      styleClass="label-seccion"/>

               <DatePicker fx:id="date"
                           prefWidth="160"
                           minWidth="160"
                           maxWidth="160"
                           prefHeight="38"
                           minHeight="38"
                           maxHeight="38"
                           onAction="#clickdate"
                           styleClass="date-stock"/>

            </HBox>


            <HBox spacing="10"
                  alignment="CENTER_LEFT"
                  maxWidth="Infinity">

               <Button fx:id="botonAgregar"
                       text="＋ Agregar"
                       onAction="#clickAgregar"
                       prefWidth="120"
                       minWidth="120"
                       maxWidth="120"
                       prefHeight="38"
                       minHeight="38"
                       maxHeight="38"
                       styleClass="btn-agregar"/>

               <Button fx:id="botonModificar"
                       text="Modificar"
                       onAction="#clickModificar"
                       prefWidth="120"
                       minWidth="120"
                       maxWidth="120"
                       prefHeight="38"
                       minHeight="38"
                       maxHeight="38"
                       styleClass="btn-stock-modificar"/>

               <Button fx:id="botonEliminar"
                       text="Eliminar"
                       onAction="#clickEliminar"
                       prefWidth="120"
                       minWidth="120"
                       maxWidth="120"
                       prefHeight="38"
                       minHeight="38"
                       maxHeight="38"
                       styleClass="btn-stock-eliminar"/>

            </HBox>

         </VBox>


         <!-- =====================================================
              BUSCADOR
              ===================================================== -->

         <VBox spacing="14"
               maxWidth="Infinity"
               styleClass="card-venta">

            <Label text="Buscar producto"
                   styleClass="label-seccion"/>


            <HBox spacing="10"
                  alignment="CENTER_LEFT"
                  maxWidth="Infinity">

               <TextField fx:id="codigo"
                          promptText="Código"
                          prefWidth="140"
                          minWidth="120"
                          maxWidth="160"
                          prefHeight="38"
                          styleClass="input"/>

               <TextField fx:id="codigoBarras"
                          promptText="Código de barras"
                          prefWidth="200"
                          minWidth="170"
                          maxWidth="230"
                          prefHeight="38"
                          styleClass="input"/>

               <TextField fx:id="buscadorProductos"
                          promptText="Buscar producto..."
                          HBox.hgrow="ALWAYS"
                          maxWidth="Infinity"
                          prefHeight="38"
                          styleClass="input-buscador"/>

               <Button fx:id="lupa"
                       text="🔍 Buscar"
                       onAction="#ClickLupa"
                       prefWidth="120"
                       minWidth="120"
                       maxWidth="120"
                       prefHeight="38"
                       minHeight="38"
                       maxHeight="38"
                       styleClass="btn-stock-buscar"/>

            </HBox>

         </VBox>


         <!-- =====================================================
              TABLA
              ===================================================== -->

         <VBox spacing="12"
               maxWidth="Infinity"
               maxHeight="Infinity"
               VBox.vgrow="ALWAYS"
               styleClass="card-venta">

            <HBox alignment="CENTER_LEFT"
                  maxWidth="Infinity">

               <Label text="Listado de stock"
                      styleClass="label-seccion"/>

            </HBox>


            <TableView VBox.vgrow="ALWAYS"
                       maxWidth="Infinity"
                       maxHeight="Infinity"
                       styleClass="tabla">

               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
               </columnResizePolicy>

               <columns>

                  <TableColumn fx:id="Codigo"
                               text="Código"
                               prefWidth="110"/>

                  <TableColumn fx:id="Producto"
                               text="Producto"
                               prefWidth="220"/>

                  <TableColumn fx:id="Cantidad"
                               text="Cantidad"
                               prefWidth="110"/>

                  <TableColumn fx:id="Descripcion"
                               text="Descripción"
                               prefWidth="260"/>

                  <TableColumn fx:id="Fecha"
                               text="Fecha"
                               prefWidth="150"/>

               </columns>

            </TableView>

         </VBox>

      </VBox>

   </center>

</BorderPane>