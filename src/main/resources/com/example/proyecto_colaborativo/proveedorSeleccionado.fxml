<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.proyecto_colaborativo.Controlador.controladorProveedorSelec"
            stylesheets="@style.css">

   <!-- ================= HEADER ================= -->

   <top>

      <HBox alignment="CENTER_LEFT"
            spacing="20"
            styleClass="header">

         <padding>
            <Insets top="20" right="30" bottom="20" left="30"/>
         </padding>

         <Label text="Productos del proveedor"
                styleClass="titulo"/>

      </HBox>

   </top>

   <!-- ================= CONTENIDO ================= -->

   <center>

      <HBox spacing="25"
            styleClass="content">

         <padding>
            <Insets top="25" right="25" bottom="25" left="25"/>
         </padding>

         <!-- ================= PANEL IZQUIERDO ================= -->

         <VBox spacing="20"
               prefWidth="350"
               styleClass="panel">

            <padding>
               <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Datos del proveedor"
                   styleClass="panel-title"/>

            <GridPane hgap="15"
                      vgap="15">

               <columnConstraints>
                  <ColumnConstraints prefWidth="110"/>
                  <ColumnConstraints hgrow="ALWAYS"/>
               </columnConstraints>

               <Label text="Nombre"
                      styleClass="form-label"/>

               <TextField fx:id="nombreProveedor"
                          editable="false"
                          GridPane.columnIndex="1"
                          styleClass="form-field"/>

               <Label text="CUIT"
                      GridPane.rowIndex="1"
                      styleClass="form-label"/>

               <TextField fx:id="cuitProveedor"
                          editable="false"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"
                          styleClass="form-field"/>

               <Label text="Correo"
                      GridPane.rowIndex="2"
                      styleClass="form-label"/>

               <TextField fx:id="correoProveedor"
                          editable="false"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"
                          styleClass="form-field"/>

               <Label text="Teléfono"
                      GridPane.rowIndex="3"
                      styleClass="form-label"/>

               <TextField fx:id="telefonoProveedor"
                          editable="false"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"
                          styleClass="form-field"/>

               <Label text="País"
                      GridPane.rowIndex="4"
                      styleClass="form-label"/>

               <TextField fx:id="paisProveedor"
                          editable="false"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="4"
                          styleClass="form-field"/>

               <Label text="Provincia"
                      GridPane.rowIndex="5"
                      styleClass="form-label"/>

               <TextField fx:id="provinciaProveedor"
                          editable="false"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="5"
                          styleClass="form-field"/>

               <Label text="Localidad"
                      GridPane.rowIndex="6"
                      styleClass="form-label"/>

               <TextField fx:id="localidadProveedor"
                          editable="false"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="6"
                          styleClass="form-field"/>

            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox spacing="15"
                  alignment="CENTER">

               <Button fx:id="botonModificarProveedor"
                       text="Modificar"
                       prefWidth="140"
                       prefHeight="40"
                       styleClass="btn-warning"
                       onAction="#botonModificarProveedor"/>

               <Button fx:id="botonEliminarProveedor"
                       text="Eliminar"
                       prefWidth="140"
                       prefHeight="40"
                       styleClass="btn-danger"
                       onAction="#botonEliminarProveedor"/>

            </HBox>

         </VBox>

         <!-- ================= PANEL DERECHO ================= -->

         <VBox spacing="15"
               HBox.hgrow="ALWAYS"
               styleClass="panel">

            <padding>
               <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

               <Label text="Lista de productos"
                      styleClass="panel-title"/>

               <Pane HBox.hgrow="ALWAYS"/>

               <TextField fx:id="txtBuscar"
                          promptText="Buscar producto..."
                          prefWidth="230"
                          styleClass="form-field"/>

               <Button fx:id="botonBuscar"
                       text="🔍 Buscar"
                       prefWidth="110"
                       prefHeight="38"
                       styleClass="btn-primary"
                       onAction="#buscarProducto"/>

            </HBox>
            <TableView fx:id="tablaProductosProovedor"
                       VBox.vgrow="ALWAYS">

               <columns>

                  <TableColumn fx:id="prooductosProovedor"
                               text="Producto"
                               prefWidth="260"/>

                  <TableColumn fx:id="precioProovedor"
                               text="Precio costo"
                               prefWidth="150"/>

                  <TableColumn fx:id="prooductosProovedor1"
                               text="Precio venta"
                               prefWidth="150"/>

                  <TableColumn fx:id="colStock"
                               text="Stock"
                               prefWidth="100"/>

               </columns>

            </TableView>

            <HBox spacing="15"
                  alignment="CENTER_RIGHT">

               <Pane HBox.hgrow="ALWAYS"/>

               <Button fx:id="botonAgregarProducto"
                       text="Agregar"
                       prefWidth="120"
                       prefHeight="40"
                       styleClass="btn-primary"
                       onAction="#botonAgregarProducto"/>

               <Button fx:id="botonModificarProducto"
                       text="Modificar"
                       prefWidth="120"
                       prefHeight="40"
                       styleClass="btn-warning"
                       onAction="#botonModificarProducto"/>

               <Button fx:id="botonEliminarProducto"
                       text="Eliminar"
                       prefWidth="120"
                       prefHeight="40"
                       styleClass="btn-danger"
                       onAction="#botonEliminarProducto"/>

            </HBox>

         </VBox>

      </HBox>

   </center>

</BorderPane>