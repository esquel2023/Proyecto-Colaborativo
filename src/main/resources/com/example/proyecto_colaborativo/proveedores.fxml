<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@stylo.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyecto_colaborativo.Controlador.controladorProovedor">

   <!-- ================= HEADER ================= -->

   <top>
      <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header">

         <padding>
            <Insets bottom="20" left="30" right="30" top="20" />
         </padding>

         <Label styleClass="titulo" text="Proveedores" />

      </HBox>
   </top>

   <!-- ================= CONTENIDO ================= -->

   <center>

      <HBox spacing="25" styleClass="content">

         <padding>
            <Insets bottom="25" left="25" right="25" top="25" />
         </padding>

         <!-- ================= FORMULARIO ================= -->

         <VBox prefWidth="420" spacing="20" styleClass="panel">

            <padding>
               <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <GridPane hgap="15" vgap="15">

               <columnConstraints>
                  <ColumnConstraints prefWidth="120" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>

               <Label styleClass="form-label" text="Nombre" />

               <TextField fx:id="nombre" styleClass="form-field" GridPane.columnIndex="1" />

               <Label styleClass="form-label" text="CUIT" GridPane.rowIndex="1" />

               <TextField fx:id="cuit" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />

               <Label styleClass="form-label" text="Correo" GridPane.rowIndex="2" />

               <TextField fx:id="email" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />

               <Label styleClass="form-label" text="Teléfono" GridPane.rowIndex="3" />

               <TextField fx:id="telefono" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="3" />

               <Label styleClass="form-label" text="Condición IVA" GridPane.rowIndex="4" />

               <ComboBox fx:id="condicionIVA" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="4" />

               <Label styleClass="form-label" text="País" GridPane.rowIndex="5" />

               <TextField fx:id="pais" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="5" />

               <Label styleClass="form-label" text="Provincia" GridPane.rowIndex="6" />

               <TextField fx:id="provincia" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="6" />

               <Label styleClass="form-label" text="Localidad" GridPane.rowIndex="7" />

               <TextField fx:id="localidad" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="7" />
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>

            </GridPane>

            <Region VBox.vgrow="ALWAYS" />

            <!-- BOTONES -->

            <HBox alignment="CENTER" spacing="15">

               <Button fx:id="botonAgregar" onAction="#botonAgrega" prefHeight="40" prefWidth="120" styleClass="btn-primary" text="Agregar" />

               <Button fx:id="botonModificar" onAction="#botonModifica" prefHeight="40" prefWidth="120" styleClass="btn-warning" text="Modificar" />

               <Button fx:id="botonEliminar" onAction="#botonEliminar" prefHeight="40" prefWidth="120" styleClass="btn-danger" text="Eliminar" />

            </HBox>

         </VBox>

         <!-- ================= TABLA ================= -->

         <VBox spacing="15" styleClass="panel" HBox.hgrow="ALWAYS">

            <padding>
               <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">

               <Label styleClass="panel-title" text="Lista de proveedores" />

               <Pane HBox.hgrow="ALWAYS" />

               <TextField fx:id="buscadorProovedores" prefWidth="240" promptText="Buscar proveedor..." styleClass="form-field" />

               <Button fx:id="botonBuscar" onAction="#buscarProveedor" prefHeight="38" prefWidth="106.0" styleClass="btn-primary" text="🔍 Buscar" />
               <Button fx:id="botonProducto" onAction="#buscarProductos" prefHeight="87.0" prefWidth="110" styleClass="btn-warning" text="Ver Productos" textAlignment="CENTER" wrapText="true" />

            </HBox>

            <TableView fx:id="tablaProovedores" VBox.vgrow="ALWAYS">

               <columns>

                  <TableColumn fx:id="nombreTabla" prefWidth="180" text="Nombre" />

                  <TableColumn fx:id="telefonoTabla" prefWidth="150" text="Teléfono" />

                  <TableColumn fx:id="colEmail" prefWidth="220" text="Correo" />

               </columns>

            </TableView>

         </VBox>

      </HBox>

   </center>

</BorderPane>
