<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com"
            xmlns:fx="http://javafx.com"
            fx:controller="com.example.proyecto_colaborativo.Controlador.controladorProovedor"
            stylesheets="@stylo.css">

   <!-- ================= HEADER ================= -->

   <top>
      <HBox alignment="CENTER_LEFT"
            spacing="20"
            styleClass="header">

         <padding>
            <Insets top="20" bottom="20" left="30" right="30"/>
         </padding>

         <Label text="Proveedores"
                styleClass="titulo"/>

      </HBox>
   </top>

   <!-- ================= CONTENIDO ================= -->

   <center>

      <HBox spacing="25"
            styleClass="content">

         <padding>
            <Insets top="25" left="25" right="25" bottom="25"/>
         </padding>

         <!-- ================= FORMULARIO ================= -->

         <VBox spacing="20"
               prefWidth="420"
               styleClass="panel">

            <padding>
               <Insets top="20" bottom="20" left="20" right="20"/>
            </padding>

            <GridPane hgap="15"
                      vgap="15">

               <columnConstraints>
                  <ColumnConstraints prefWidth="120"/>
                  <ColumnConstraints hgrow="ALWAYS"/>
               </columnConstraints>

               <Label text="Nombre"
                      styleClass="form-label"/>

               <TextField fx:id="nombre"
                          GridPane.columnIndex="1"
                          styleClass="form-field"/>

               <Label text="CUIT"
                      GridPane.rowIndex="1"
                      styleClass="form-label"/>

               <TextField fx:id="cuit"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"
                          styleClass="form-field"/>

               <Label text="Correo"
                      GridPane.rowIndex="2"
                      styleClass="form-label"/>

               <TextField fx:id="email"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"
                          styleClass="form-field"/>

               <Label text="Teléfono"
                      GridPane.rowIndex="3"
                      styleClass="form-label"/>

               <TextField fx:id="telefono"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"
                          styleClass="form-field"/>

               <Label text="Condición IVA"
                      GridPane.rowIndex="4"
                      styleClass="form-label"/>

               <ComboBox fx:id="condicionIVA"
                         GridPane.columnIndex="1"
                         GridPane.rowIndex="4"
                         styleClass="form-field"/>

               <Label text="País"
                      GridPane.rowIndex="5"
                      styleClass="form-label"/>

               <TextField fx:id="pais"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="5"
                          styleClass="form-field"/>

               <Label text="Provincia"
                      GridPane.rowIndex="6"
                      styleClass="form-label"/>

               <TextField fx:id="provincia"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="6"
                          styleClass="form-field"/>

               <Label text="Localidad"
                      GridPane.rowIndex="7"
                      styleClass="form-label"/>

               <TextField fx:id="localidad"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="7"
                          styleClass="form-field"/>

            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- BOTONES -->

            <HBox alignment="CENTER"
                  spacing="15">

               <Button fx:id="botonAgregar"
                       text="Agregar"
                       prefWidth="120"
                       prefHeight="40"
                       styleClass="btn-primary"
                       onAction="#botonAgregar"/>

               <Button fx:id="botonModificar"
                       text="Modificar"
                       prefWidth="120"
                       prefHeight="40"
                       styleClass="btn-warning"
                       onAction="#botonModificar"/>

               <Button fx:id="botonEliminar"
                       text="Eliminar"
                       prefWidth="120"
                       prefHeight="40"
                       styleClass="btn-danger"
                       onAction="#botonEliminar"/>

            </HBox>

         </VBox>

         <!-- ================= TABLA ================= -->

         <VBox spacing="15"
               HBox.hgrow="ALWAYS"
               styleClass="panel">

            <padding>
               <Insets top="20" bottom="20" left="20" right="20"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="10">

               <Label text="Lista de proveedores"
                      styleClass="panel-title"/>

               <Pane HBox.hgrow="ALWAYS"/>

               <TextField fx:id="txtBuscar"
                          promptText="Buscar proveedor..."
                          prefWidth="240"
                          styleClass="form-field"/>

               <Button fx:id="botonBuscar"
                       text="🔍 Buscar"
                       prefWidth="110"
                       prefHeight="38"
                       styleClass="btn-primary"
                       onAction="#buscarProveedor"/>

            </HBox>

            <TableView fx:id="tablaProveedores"
                       VBox.vgrow="ALWAYS">

               <columns>

                  <TableColumn fx:id="colNombre"
                               text="Nombre"
                               prefWidth="180"/>

                  <TableColumn fx:id="colTelefono"
                               text="Teléfono"
                               prefWidth="150"/>

                  <TableColumn fx:id="colEmail"
                               text="Correo"
                               prefWidth="220"/>

               </columns>

            </TableView>

         </VBox>

      </HBox>

   </center>

</BorderPane>