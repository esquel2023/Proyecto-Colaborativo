<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyecto_colaborativo.Controlador.controladorProovedor"
            stylesheets="@style.css"
            styleClass="root-proveedores">

   <center>

      <VBox spacing="16"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="content">

         <padding>
            <Insets top="16"
                    right="16"
                    bottom="16"
                    left="16"/>
         </padding>


         <!-- =====================================================
              HEADER
              ===================================================== -->

         <HBox alignment="CENTER_LEFT"
               maxWidth="Infinity"
               styleClass="header-simple">

            <VBox spacing="3"
                  HBox.hgrow="ALWAYS">

               <Label text="🚚 Proveedores"
                      styleClass="titulo-oscuro"/>

               <Label text="Gestión y registro de proveedores"
                      styleClass="subtitulo-oscuro"/>

            </VBox>

            <VBox alignment="CENTER_RIGHT"
                  spacing="2">

               <Label fx:id="fechaLabel"
                      text="Fecha"
                      styleClass="fecha-texto"/>

               <Label fx:id="horaLabel"
                      text="Hora"
                      styleClass="hora-texto"/>

            </VBox>

         </HBox>


         <!-- =====================================================
              CUERPO
              ===================================================== -->

         <HBox spacing="16"
               maxWidth="Infinity"
               maxHeight="Infinity"
               VBox.vgrow="ALWAYS">


            <!-- =================================================
                 FORMULARIO
                 ================================================= -->

            <VBox spacing="14"
                  prefWidth="300"
                  minWidth="280"
                  maxWidth="320"
                  maxHeight="Infinity"
                  styleClass="card-venta">

               <Label text="Datos del proveedor"
                      styleClass="label-seccion"/>


               <GridPane hgap="10"
                         vgap="10"
                         maxWidth="Infinity">

                  <columnConstraints>

                     <ColumnConstraints minWidth="90"
                                        prefWidth="100"
                                        maxWidth="100"/>

                     <ColumnConstraints minWidth="120"
                                        hgrow="ALWAYS"/>

                  </columnConstraints>


                  <!-- NOMBRE -->

                  <Label text="Nombre"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="0"
                         styleClass="label-seccion"/>

                  <TextField fx:id="nombre"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="0"
                             maxWidth="Infinity"
                             styleClass="input"/>


                  <!-- CUIT -->

                  <Label text="CUIT"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="1"
                         styleClass="label-seccion"/>

                  <TextField fx:id="cuit"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="1"
                             maxWidth="Infinity"
                             styleClass="input"/>


                  <!-- CORREO -->

                  <Label text="Correo"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="2"
                         styleClass="label-seccion"/>

                  <TextField fx:id="email"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="2"
                             maxWidth="Infinity"
                             styleClass="input"/>


                  <!-- TELEFONO -->

                  <Label text="Teléfono"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="3"
                         styleClass="label-seccion"/>

                  <TextField fx:id="telefono"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="3"
                             maxWidth="Infinity"
                             styleClass="input"/>


                  <!-- CONDICION IVA -->

                  <Label text="Condición IVA"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="4"
                         wrapText="true"
                         styleClass="label-seccion"/>

                  <ComboBox fx:id="condicionIVA"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="4"
                            maxWidth="Infinity"
                            styleClass="combo"/>


                  <!-- PAIS -->

                  <Label text="País"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="5"
                         styleClass="label-seccion"/>

                  <TextField fx:id="pais"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="5"
                             maxWidth="Infinity"
                             styleClass="input"/>


                  <!-- PROVINCIA -->

                  <Label text="Provincia"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="6"
                         styleClass="label-seccion"/>

                  <TextField fx:id="provincia"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="6"
                             maxWidth="Infinity"
                             styleClass="input"/>


                  <!-- LOCALIDAD -->

                  <Label text="Localidad"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="7"
                         styleClass="label-seccion"/>

                  <TextField fx:id="localidad"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="7"
                             maxWidth="Infinity"
                             styleClass="input"/>

               </GridPane>


               <Region VBox.vgrow="ALWAYS"/>


               <!-- =================================================
                    BOTONES
                    ================================================= -->

               <VBox spacing="10">

                  <HBox spacing="10"
                        alignment="CENTER">

                     <Button fx:id="botonAgregar"
                             text="＋ Agregar"
                             onAction="#botonAgregar"
                             HBox.hgrow="ALWAYS"
                             maxWidth="Infinity"
                             prefHeight="38"
                             styleClass="btn-agregar"/>

                     <Button fx:id="botonModificar"
                             text="Modificar"
                             onAction="#botonModificar"
                             HBox.hgrow="ALWAYS"
                             maxWidth="Infinity"
                             prefHeight="38"
                             styleClass="btn-proveedor-modificar"/>

                  </HBox>


                  <Button fx:id="botonEliminar"
                          text="Eliminar"
                          onAction="#botonEliminar"
                          maxWidth="Infinity"
                          prefHeight="38"
                          styleClass="btn-proveedor-eliminar"/>

               </VBox>

            </VBox>


            <!-- =================================================
                 LISTADO
                 ================================================= -->

            <VBox spacing="14"
                  HBox.hgrow="ALWAYS"
                  maxWidth="Infinity"
                  maxHeight="Infinity"
                  styleClass="card-venta">

               <Label text="Lista de proveedores"
                      styleClass="label-seccion"/>


               <!-- BUSCADOR -->

               <HBox spacing="10"
                     alignment="CENTER_LEFT"
                     maxWidth="Infinity">

                  <TextField fx:id="txtBuscar"
                             promptText="Buscar proveedor..."
                             HBox.hgrow="ALWAYS"
                             maxWidth="Infinity"
                             styleClass="input-buscador"/>

                  <Button fx:id="botonBuscar"
                          text="🔍 Buscar"
                          onAction="#buscarProveedor"
                          prefWidth="120"
                          minWidth="120"
                          maxWidth="120"
                          prefHeight="38"
                          minHeight="38"
                          maxHeight="38"
                          styleClass="btn-agregar"/>

               </HBox>


               <!-- =================================================
                    TABLA
                    ================================================= -->

               <TableView fx:id="tablaProveedores"
                          VBox.vgrow="ALWAYS"
                          maxWidth="Infinity"
                          maxHeight="Infinity"
                          styleClass="tabla">

                  <columns>

                     <TableColumn fx:id="colNombre"
                                  text="Nombre"
                                  prefWidth="180"/>

                     <TableColumn fx:id="colTelefono"
                                  text="Teléfono"
                                  prefWidth="150"/>

                     <TableColumn fx:id="colEmail"
                                  text="Correo"
                                  prefWidth="220"/>

                  </columns>

               </TableView>

            </VBox>

         </HBox>

      </VBox>

   </center>

</BorderPane>