<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyecto_colaborativo.Controlador.controladorCliente"
            stylesheets="@style.css"
            styleClass="root-clientes">

   <center>

      <VBox spacing="16"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="content">

         <padding>
            <Insets top="16"
                    right="16"
                    bottom="16"
                    left="16"/>
         </padding>

         <!-- =====================================================
              HEADER
              ===================================================== -->

         <HBox alignment="CENTER_LEFT"
               maxWidth="Infinity"
               styleClass="header-simple">

            <VBox spacing="3"
                  HBox.hgrow="ALWAYS">

               <Label text="👥 Clientes"
                      styleClass="titulo-oscuro"/>

               <Label text="Gestión y registro de clientes"
                      styleClass="subtitulo-oscuro"/>

            </VBox>

         </HBox>

         <!-- =====================================================
              CUERPO
              ===================================================== -->

         <HBox spacing="16"
               maxWidth="Infinity"
               maxHeight="Infinity"
               VBox.vgrow="ALWAYS">

            <!-- =================================================
                 FORMULARIO IZQUIERDO
                 ================================================= -->

            <VBox spacing="14"
                  prefWidth="300"
                  minWidth="280"
                  maxWidth="320"
                  maxHeight="Infinity"
                  styleClass="card-venta">

               <Label text="Datos del cliente"
                      styleClass="label-seccion"/>

               <GridPane hgap="10"
                         vgap="10"
                         maxWidth="Infinity">

                  <columnConstraints>

                     <ColumnConstraints minWidth="90"
                                        prefWidth="100"
                                        maxWidth="100"/>

                     <ColumnConstraints minWidth="120"
                                        hgrow="ALWAYS"/>

                  </columnConstraints>

                  <!-- NOMBRE -->

                  <Label text="Nombre"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="0"
                         styleClass="label-seccion"/>

                  <TextField fx:id="nombreApellido"
                             promptText="Nombre y apellido"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="0"
                             maxWidth="Infinity"
                             styleClass="input"/>

                  <!-- DNI -->

                  <Label text="DNI"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="1"
                         styleClass="label-seccion"/>

                  <TextField fx:id="dni"
                             promptText="DNI"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="1"
                             maxWidth="Infinity"
                             styleClass="input"/>

                  <!-- CUIL -->

                  <Label text="CUIL"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="2"
                         styleClass="label-seccion"/>

                  <TextField fx:id="cuil"
                             promptText="CUIL"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="2"
                             maxWidth="Infinity"
                             styleClass="input"/>

                  <!-- TELEFONO -->

                  <Label text="Teléfono"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="3"
                         styleClass="label-seccion"/>

                  <TextField fx:id="telefono"
                             promptText="Teléfono"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="3"
                             maxWidth="Infinity"
                             styleClass="input"/>

                  <!-- EMAIL -->

                  <Label text="Correo"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="4"
                         styleClass="label-seccion"/>

                  <TextField fx:id="email"
                             promptText="Correo electrónico"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="4"
                             maxWidth="Infinity"
                             styleClass="input"/>

                  <!-- DIRECCION -->

                  <Label text="Dirección"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="5"
                         styleClass="label-seccion"/>

                  <TextField fx:id="direccion"
                             promptText="Dirección"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="5"
                             maxWidth="Infinity"
                             styleClass="input"/>

               </GridPane>

               <Region VBox.vgrow="ALWAYS"/>

               <!-- =================================================
                    BOTONES
                    ================================================= -->

               <VBox spacing="10">

                  <HBox spacing="10"
                        alignment="CENTER">

                     <Button text="＋ Agregar"
                             onAction="#botonAgregar"
                             HBox.hgrow="ALWAYS"
                             maxWidth="Infinity"
                             prefHeight="38"
                             styleClass="btn-agregar"/>

                     <Button text="Modificar"
                             onAction="#botonModificar"
                             HBox.hgrow="ALWAYS"
                             maxWidth="Infinity"
                             prefHeight="38"
                             styleClass="btn-proveedor-modificar"/>

                  </HBox>

                  <Button text="Eliminar"
                          onAction="#botonElimina"
                          maxWidth="Infinity"
                          prefHeight="38"
                          styleClass="btn-proveedor-eliminar"/>

               </VBox>

            </VBox>

            <!-- =================================================
                 PANEL DERECHO
                 ================================================= -->

            <VBox spacing="14"
                  HBox.hgrow="ALWAYS"
                  maxWidth="Infinity"
                  maxHeight="Infinity"
                  styleClass="card-venta">

               <!-- TITULO -->

               <HBox alignment="CENTER_LEFT">

                  <Label text="Lista de clientes"
                         styleClass="label-seccion"/>

                  <Region HBox.hgrow="ALWAYS"/>

                  <Label fx:id="totalclientes"
                         text="Cantidad total de clientes:"
                         styleClass="subtitulo-oscuro"/>

               </HBox>

               <!-- =================================================
                    BUSCADOR
                    ================================================= -->

               <HBox spacing="10"
                     alignment="CENTER_LEFT"
                     maxWidth="Infinity">

                  <TextField fx:id="buscadorClientes"
                             promptText="Buscar cliente..."
                             HBox.hgrow="ALWAYS"
                             maxWidth="Infinity"
                             styleClass="input-buscador"/>

                  <Button text="🔍 Buscar"
                          onAction="#botonLupa"
                          prefWidth="120"
                          minWidth="120"
                          maxWidth="120"
                          prefHeight="38"
                          minHeight="38"
                          maxHeight="38"
                          styleClass="btn-agregar"/>

               </HBox>

               <!-- =================================================
                    TABLA CLIENTES
                    ================================================= -->

               <TableView fx:id="tablaClientes"
                          VBox.vgrow="ALWAYS"
                          maxWidth="Infinity"
                          maxHeight="Infinity"
                          styleClass="tabla">

                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                  </columnResizePolicy>

                  <columns>

                     <TableColumn fx:id="nombreTabla"
                                  text="Nombre y Apellido"
                                  prefWidth="220"/>

                     <TableColumn fx:id="dniTabla"
                                  text="DNI"
                                  prefWidth="140"/>

                     <TableColumn fx:id="telefonoTabla"
                                  text="Teléfono"
                                  prefWidth="160"/>

                  </columns>

               </TableView>

               <!-- =================================================
                    HISTORIAL DEL CLIENTE
                    ================================================= -->

               <HBox alignment="CENTER_RIGHT"
                     spacing="10">

                  <Button fx:id="botonHistorial"
                          text="📄 Ver historial de facturas"
                          onAction="#abrirHistorialCliente"
                          prefWidth="260"
                          minWidth="260"
                          maxWidth="260"
                          prefHeight="38"
                          styleClass="btn-cliente"/>

               </HBox>

            </VBox>

         </HBox>

      </VBox>

   </center>

</BorderPane>