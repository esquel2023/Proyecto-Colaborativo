<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="520.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyecto_colaborativo.Controlador.ControladorProducto"
            stylesheets="@style.css">

    <children>
        <VBox spacing="14"
              AnchorPane.topAnchor="16"
              AnchorPane.rightAnchor="16"
              AnchorPane.bottomAnchor="16"
              AnchorPane.leftAnchor="16"
              styleClass="root-ventas">

            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="header-simple">
                <Label text="📦" styleClass="icono-header"/>

                <VBox spacing="2">
                    <Label text="Productos" styleClass="titulo-oscuro"/>
                    <Label text="Gestión de productos" styleClass="subtitulo-oscuro"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="labelFecha" styleClass="fecha-texto"/>
                    <Label fx:id="labelHora" styleClass="hora-texto"/>
                </VBox>
            </HBox>

            <HBox spacing="14" VBox.vgrow="ALWAYS">

                <VBox spacing="12" styleClass="card-venta" HBox.hgrow="ALWAYS">

                    <VBox spacing="8">
                        <Label text="🔍 Buscar producto" styleClass="label-seccion"/>

                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="txtbuscadorProductos"
                                       promptText="Nombre, código o código de barras"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="input"/>

                            <Button text="🔍"
                                    minWidth="48"
                                    styleClass="btn-agregar"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8" VBox.vgrow="ALWAYS">
                        <Label text="☰ Productos registrados" styleClass="label-seccion"/>

                        <TableView fx:id="tablaProductos"
                                   styleClass="tabla"
                                   VBox.vgrow="ALWAYS">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <columns>
                                <TableColumn fx:id="colCodigo" text="Código" prefWidth="90"/>
                                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
                                <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="100"/>
                                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="120"/>
                            </columns>
                        </TableView>
                    </VBox>

                </VBox>

                <VBox spacing="16" styleClass="resumen-card" prefWidth="300">

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📊" styleClass="icono-resumen"/>
                        <Label text="Información del producto" styleClass="resumen-titulo"/>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="Precio costo" styleClass="label-resumen"/>
                        <TextField fx:id="precioCosto"
                                   promptText="0.00"
                                   styleClass="input"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Ganancia (%)" styleClass="label-resumen"/>
                        <TextField fx:id="porcentaje"
                                   promptText="0 %"
                                   styleClass="input"/>
                    </VBox>

                    <VBox spacing="6" styleClass="barra-acciones">
                        <Label text="Precio de venta" styleClass="label-resumen"/>
                        <Label text="0.00" styleClass="total-grande"/>
                    </VBox>

                    <Button fx:id="botonAgregar"
                            text="+  Agregar"
                            onAction="#clickAgregar"
                            maxWidth="Infinity"
                            styleClass="btn-agregar"/>

                    <Button fx:id="botonModificar"
                            text="✏  Modificar"
                            onAction="#clickModificar"
                            maxWidth="Infinity"
                            styleClass="btn-cliente"/>

                    <Button fx:id="botonEliminar"
                            text="🗑  Eliminar"
                            onAction="#clickEliminar"
                            maxWidth="Infinity"
                            styleClass="btn-eliminar-cliente"/>

                    <Separator/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button fx:id="botonSalir"
                            text="↪  Salir"
                            onAction="#clickSalir"
                            maxWidth="Infinity"
                            styleClass="btn-toolbar"/>

                </VBox>

            </HBox>

        </VBox>
    </children>
</AnchorPane>