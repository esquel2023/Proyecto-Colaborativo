<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<BorderPane
        prefHeight="720.0"
        prefWidth="1100.0"
        minHeight="600.0"
        minWidth="900.0"
        maxWidth="Infinity"
        maxHeight="Infinity"
        styleClass="root"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.proyecto_colaborativo.HelloController">
    <!-- ==================== SIDEBAR ==================== -->

    <left>

        <VBox prefWidth="220.0"
              minWidth="220.0"
              maxWidth="220.0"
              spacing="12.0"
              BorderPane.alignment="CENTER"
              styleClass="sidebar">

            <padding>
                <Insets top="25" right="18" bottom="25" left="18"/>
            </padding>

            <Label text=":)"
                   styleClass="sidebar-title"/>


            <!-- INICIO -->

            <Button text="🏠  Inicio"
                    onAction="#botonInicio"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>


            <!-- CAJA -->

            <Button fx:id="caja"
                    text="💰  Caja"
                    onAction="#botonCaja"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>


            <!-- VENTAS -->

            <Button fx:id="ventas"
                    text="🛒  Ventas"
                    onAction="#botonVentas"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>


            <!-- PRODUCTOS -->

            <Button fx:id="productos"
                    text="📦  Productos"
                    onAction="#botonProductos"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>


            <!-- PROVEEDORES -->

            <Button fx:id="proveedores"
                    text="🚚  Proveedores"
                    onAction="#botonProveedores"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>


            <!-- STOCK -->

            <Button fx:id="stock"
                    text="📚  Stock"
                    onAction="#botonStock"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>


            <!-- CLIENTES -->

            <Button fx:id="clientes"
                    text="👥  Clientes"
                    onAction="#botonClientes"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>


            <!-- FACTURAS -->

            <Button fx:id="factura"
                    text="🧾  Facturas"
                    onAction="#botonFactura"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>


            <Region VBox.vgrow="ALWAYS"/>


            <Button text="⚙  Configuración"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>


            <Button text="🚪  Cerrar sesión"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>

        </VBox>

    </left>


    <!-- ================================================= -->
    <!-- CONTENIDO DE LA DERECHA -->
    <!-- ================================================= -->

    <center>

        <StackPane fx:id="contenidoPrincipal"
                   maxWidth="Infinity"
                   maxHeight="Infinity">


            <!-- ============================================= -->
            <!-- INICIO -->
            <!-- ============================================= -->

            <VBox fx:id="vistaInicio"
                  spacing="20.0"
                  maxWidth="Infinity"
                  maxHeight="Infinity"
                  styleClass="content">

                <padding>
                    <Insets top="25"
                            right="30"
                            bottom="25"
                            left="30"/>
                </padding>


                <!-- ================= HEADER ================= -->

                <HBox alignment="CENTER_LEFT"
                      maxWidth="Infinity">

                    <VBox HBox.hgrow="ALWAYS"
                          spacing="5">

                        <Label fx:id="saludoLabel"
                               text="¡Bienvenida a Axyra!"
                               styleClass="titulo"/>

                        <Label text="Te deseamos una excelente jornada de ventas."
                               styleClass="subtitulo"/>

                    </VBox>


                    <Label fx:id="fechaHoraLabel"
                           text="Fecha y hora"
                           styleClass="fecha"/>

                </HBox>


                <!-- ================= CARDS ================= -->

                <GridPane hgap="20"
                          vgap="20"
                          maxWidth="Infinity"
                          maxHeight="Infinity"
                          VBox.vgrow="ALWAYS">

                    <columnConstraints>

                        <ColumnConstraints percentWidth="50"
                                           hgrow="ALWAYS"
                                           fillWidth="true"/>

                        <ColumnConstraints percentWidth="50"
                                           hgrow="ALWAYS"
                                           fillWidth="true"/>

                    </columnConstraints>


                    <rowConstraints>

                        <RowConstraints minHeight="130"
                                        prefHeight="160"
                                        vgrow="ALWAYS"
                                        fillHeight="true"/>

                        <RowConstraints minHeight="130"
                                        prefHeight="160"
                                        vgrow="ALWAYS"
                                        fillHeight="true"/>

                    </rowConstraints>


                    <!-- CAJA -->

                    <VBox spacing="10"
                          maxWidth="Infinity"
                          maxHeight="Infinity"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="0">

                        <styleClass>
                            <String fx:value="card"/>
                            <String fx:value="card-caja"/>
                        </styleClass>

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT"
                              maxWidth="Infinity">

                            <Label text="💰 Caja"
                                   styleClass="card-title"
                                   HBox.hgrow="ALWAYS"/>

                            <Button fx:id="btnOjoCaja"
                                    onAction="#toggleCaja"
                                    styleClass="eye-button"/>

                        </HBox>

                        <Label fx:id="lblCaja"
                               text="0,00"
                               styleClass="card-number"/>

                        <Label text="Total disponible"
                               styleClass="card-subtitle"/>

                    </VBox>


                    <!-- VENTAS -->

                    <VBox spacing="8"
                          maxWidth="Infinity"
                          maxHeight="Infinity"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0">

                        <styleClass>
                            <String fx:value="card"/>
                            <String fx:value="card-ventas"/>
                        </styleClass>

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <Label text="🛒 Ventas de hoy"
                               styleClass="card-title"/>

                        <Label text="0"
                               styleClass="card-number"/>

                        <Label text="Operaciones realizadas"
                               styleClass="card-subtitle"/>

                    </VBox>


                    <!-- CLIENTES -->

                    <VBox spacing="8"
                          maxWidth="Infinity"
                          maxHeight="Infinity"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="1">

                        <styleClass>
                            <String fx:value="card"/>
                            <String fx:value="card-clientes"/>
                        </styleClass>

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <Label text="👥 Clientes"
                               styleClass="card-title"/>

                        <Label text="0"
                               styleClass="card-number"/>

                        <Label text="Clientes registrados"
                               styleClass="card-subtitle"/>

                    </VBox>


                    <!-- STOCK -->

                    <VBox spacing="8"
                          maxWidth="Infinity"
                          maxHeight="Infinity"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1">

                        <styleClass>
                            <String fx:value="card"/>
                            <String fx:value="card-stock"/>
                        </styleClass>

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <Label text="⚠ Stock bajo"
                               styleClass="card-title"/>

                        <Label text="0"
                               styleClass="card-number"/>

                        <Label text="Productos por reponer"
                               styleClass="card-subtitle"/>

                    </VBox>

                </GridPane>


                <!-- ================= ULTIMAS VENTAS ================= -->

                <VBox spacing="12"
                      minHeight="100"
                      maxWidth="Infinity"
                      styleClass="panel">

                    <padding>
                        <Insets top="20"
                                right="20"
                                bottom="20"
                                left="20"/>
                    </padding>

                    <Label text="Últimas ventas realizadas"
                           styleClass="panel-title"/>

                    <Label text="Todavía no hay ventas cargadas."
                           styleClass="subtitulo"/>

                </VBox>

            </VBox>

        </StackPane>

    </center>

</BorderPane>