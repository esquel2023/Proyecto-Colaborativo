<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<?import javafx.scene.control.Tooltip?>
<BorderPane prefHeight="620.0" prefWidth="980.0"
            styleClass="root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyecto_colaborativo.HelloController">

    <left>
        <VBox prefWidth="220.0" spacing="12.0" styleClass="sidebar">
            <padding>
                <Insets top="25" right="18" bottom="25" left="18"/>
            </padding>

            <Label text="AXYRA" styleClass="sidebar-title"/>

            <Button text="🏠  Inicio" styleClass="sidebar-button"/>
            <Button fx:id="caja" text="💰  Caja" onAction="#botonCaja" styleClass="sidebar-button"/>
            <Button fx:id="ventas" text="🛒  Ventas" onAction="#botonVentas" styleClass="sidebar-button"/>
            <Button fx:id="productos" text="📦  Productos" onAction="#botonProductos" styleClass="sidebar-button"/>
            <Button fx:id="proveedores" text="🚚  Proveedores" onAction="#botonProveedores" styleClass="sidebar-button"/>
            <Button fx:id="stock" text="📚  Stock" onAction="#botonStock" styleClass="sidebar-button"/>
            <Button fx:id="clientes" text="👥  Clientes" onAction="#botonClientes" styleClass="sidebar-button"/>
            <Button fx:id="factura" text="🧾  Facturas" onAction="#botonFactura" styleClass="sidebar-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="⚙  Configuración" styleClass="sidebar-button"/>
            <Button text="🚪  Cerrar sesión" styleClass="sidebar-button"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="25.0" styleClass="content">
            <padding>
                <Insets top="35" right="40" bottom="35" left="40"/>
            </padding>

            <HBox alignment="CENTER_LEFT">

                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label fx:id="saludoLabel"
                           text="¡Bienvenida a Axyra!"
                           styleClass="titulo"/>

                    <Label text="Te deseamos una excelente jornada de ventas."
                           styleClass="subtitulo"/>
                </VBox>

                <Label fx:id="fechaHoraLabel"
                       text="Fecha y hora"
                       styleClass="fecha"/>

            </HBox>

            <GridPane hgap="25" vgap="25">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints minHeight="160" prefHeight="170"/>
                    <RowConstraints minHeight="160" prefHeight="170"/>
                </rowConstraints>

                <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <styleClass>
                        <String fx:value="card"/>
                        <String fx:value="card-caja"/>
                    </styleClass>

                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="💰 Caja" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnOjoCaja"  onAction="#toggleCaja" styleClass="eye-button"/>
                    </HBox>

                    <Label fx:id="lblCaja" text="0,00" styleClass="card-number"/>
                    <Label text="Total disponible" styleClass="card-subtitle"/>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">

                    <styleClass>
                        <String fx:value="card"/>
                        <String fx:value="card-ventas"/>
                    </styleClass>

                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label text="🛒 Ventas de hoy" styleClass="card-title"/>
                    <Label text="0" styleClass="card-number"/>
                    <Label text="Operaciones realizadas" styleClass="card-subtitle"/>

                </VBox>

                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <styleClass>
                        <String fx:value="card"/>
                        <String fx:value="card-clientes"/>
                    </styleClass>
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <Label text="👥 Clientes" styleClass="card-title"/>
                    <Label text="0" styleClass="card-number"/>
                    <Label text="Clientes registrados" styleClass="card-subtitle"/>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <styleClass>
                        <String fx:value="card"/>
                        <String fx:value="card-stock"/>
                    </styleClass>
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <Label text="⚠ Stock bajo" styleClass="card-title"/>
                    <Label text="0" styleClass="card-number"/>
                    <Label text="Productos por reponer" styleClass="card-subtitle"/>
                </VBox>
            </GridPane>

            <VBox spacing="12" styleClass="panel">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Últimas ventas realizadas" styleClass="panel-title"/>
                <Label text="Todavía no hay ventas cargadas." styleClass="subtitulo"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>

